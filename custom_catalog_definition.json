{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/himaks1/OrchrestratorA2UI/main/custom_catalog_definition.json",
  "catalogId": "https://raw.githubusercontent.com/himaks1/OrchrestratorA2UI/main/custom_catalog_definition.json",
  "title": "Custom Enterprise Data & Analytics Catalog",
  "description": "A custom A2UI catalog supporting interactive DataTables, DataGrids, Charts (Bar, Line, Pie, Doughnut, Area), and standard layout elements.",
  "components": {
    "Text": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Text"
            },
            "text": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "The text content to display. Supports markdown formatting."
            },
            "variant": {
              "type": "string",
              "description": "A hint for the base text style.",
              "enum": ["h1", "h2", "h3", "h4", "h5", "caption", "body"],
              "default": "body"
            }
          },
          "required": ["component", "text"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Image": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Image"
            },
            "url": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "The URL of the image to display."
            },
            "fit": {
              "type": "string",
              "description": "CSS object-fit property.",
              "enum": ["contain", "cover", "fill", "none", "scaleDown"],
              "default": "fill"
            },
            "variant": {
              "type": "string",
              "description": "A hint for the image size and style.",
              "enum": ["icon", "avatar", "smallFeature", "mediumFeature", "largeFeature", "header"],
              "default": "mediumFeature"
            }
          },
          "required": ["component", "url"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Icon": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Icon"
            },
            "name": {
              "description": "The icon name or SVG path.",
              "type": "string"
            }
          },
          "required": ["component", "name"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Row": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "description": "A layout component that arranges its children horizontally.",
          "properties": {
            "component": {
              "const": "Row"
            },
            "children": {
              "$ref": "common_types.json#/$defs/ChildList"
            },
            "justify": {
              "type": "string",
              "enum": ["center", "end", "spaceAround", "spaceBetween", "spaceEvenly", "start", "stretch"],
              "default": "start"
            },
            "align": {
              "type": "string",
              "enum": ["start", "center", "end", "stretch"],
              "default": "stretch"
            }
          },
          "required": ["component", "children"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Column": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "description": "A layout component that arranges its children vertically.",
          "properties": {
            "component": {
              "const": "Column"
            },
            "children": {
              "$ref": "common_types.json#/$defs/ChildList"
            },
            "justify": {
              "type": "string",
              "enum": ["start", "center", "end", "spaceBetween", "spaceAround", "spaceEvenly", "stretch"],
              "default": "start"
            },
            "align": {
              "type": "string",
              "enum": ["center", "end", "start", "stretch"],
              "default": "stretch"
            }
          },
          "required": ["component", "children"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Card": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Card"
            },
            "child": {
              "$ref": "common_types.json#/$defs/ComponentId",
              "description": "The ID of the child component inside the card."
            }
          },
          "required": ["component", "child"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Button": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "$ref": "common_types.json#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Button"
            },
            "child": {
              "$ref": "common_types.json#/$defs/ComponentId"
            },
            "variant": {
              "type": "string",
              "enum": ["default", "primary", "borderless"],
              "default": "default"
            },
            "action": {
              "$ref": "common_types.json#/$defs/Action"
            }
          },
          "required": ["component", "child", "action"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Divider": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Divider"
            },
            "axis": {
              "type": "string",
              "enum": ["horizontal", "vertical"],
              "default": "horizontal"
            }
          },
          "required": ["component"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Tabs": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Tabs"
            },
            "tabs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "$ref": "common_types.json#/$defs/DynamicString"
                  },
                  "child": {
                    "$ref": "common_types.json#/$defs/ComponentId"
                  }
                },
                "required": ["title", "child"],
                "additionalProperties": false
              }
            }
          },
          "required": ["component", "tabs"]
        }
      ],
      "unevaluatedProperties": false
    },
    "DataTable": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "description": "An interactive tabular data grid component with sorting, pagination, and formatting.",
          "properties": {
            "component": {
              "const": "DataTable"
            },
            "title": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "The title or caption of the data table."
            },
            "columns": {
              "type": "array",
              "description": "Column configurations for the table.",
              "items": {
                "$ref": "#/$defs/TableColumn"
              }
            },
            "rows": {
              "description": "The table data rows as an array of row objects or a data model binding path.",
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                {
                  "$ref": "common_types.json#/$defs/DataBinding"
                }
              ]
            },
            "pageSize": {
              "type": "number",
              "description": "Number of rows per page.",
              "default": 10
            },
            "sortable": {
              "type": "boolean",
              "description": "Whether columns can be clicked to sort.",
              "default": true
            },
            "searchable": {
              "type": "boolean",
              "description": "Whether a quick-search filter input is displayed.",
              "default": false
            }
          },
          "required": ["component", "columns", "rows"]
        }
      ],
      "unevaluatedProperties": false
    },
    "DataGrid": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "description": "Advanced enterprise data grid component alias.",
          "properties": {
            "component": {
              "const": "DataGrid"
            },
            "title": {
              "$ref": "common_types.json#/$defs/DynamicString"
            },
            "columns": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TableColumn"
              }
            },
            "rows": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                {
                  "$ref": "common_types.json#/$defs/DataBinding"
                }
              ]
            },
            "pageSize": {
              "type": "number",
              "default": 10
            },
            "sortable": {
              "type": "boolean",
              "default": true
            }
          },
          "required": ["component", "columns", "rows"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Chart": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "description": "Interactive data visualization component supporting bar, line, pie, doughnut, and area charts.",
          "properties": {
            "component": {
              "const": "Chart"
            },
            "type": {
              "type": "string",
              "description": "The chart type.",
              "enum": ["bar", "line", "pie", "doughnut", "area"]
            },
            "title": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "Chart header title."
            },
            "xAxis": {
              "$ref": "#/$defs/AxisConfig",
              "description": "Configuration for horizontal x-axis."
            },
            "yAxis": {
              "$ref": "#/$defs/AxisConfig",
              "description": "Configuration for vertical y-axis."
            },
            "chartData": {
              "description": "Data points for the chart.",
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ChartItem"
                  }
                },
                {
                  "$ref": "common_types.json#/$defs/DataBinding"
                }
              ]
            }
          },
          "required": ["component", "type", "chartData"]
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "$defs": {
    "CatalogComponentCommon": {
      "type": "object",
      "properties": {
        "weight": {
          "$ref": "common_types.json#/$defs/DynamicNumber"
        }
      }
    },
    "TableColumn": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "The field key matching the row data property."
        },
        "label": {
          "type": "string",
          "description": "The human-readable column header text."
        },
        "type": {
          "type": "string",
          "enum": ["string", "number", "currency", "date", "boolean"],
          "default": "string"
        },
        "sortable": {
          "type": "boolean",
          "default": true
        },
        "width": {
          "type": "string",
          "description": "Optional CSS width hint (e.g. '150px', '20%')."
        }
      },
      "required": ["key", "label"]
    },
    "AxisConfig": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      }
    },
    "ChartItem": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "category": {
          "type": "string"
        },
        "drillDown": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "number"
              }
            },
            "required": ["label", "value"]
          }
        }
      },
      "required": ["label", "value"]
    }
  }
}
